class Employee:
    def __init__(self, emp_id, name, salary):
        self.emp_id = emp_id
        self.name = name
        self.salary = salary

    def display(self):
        print("ID:", self.emp_id)
        print("Name:", self.name)
        print("Salary:", self.salary)

emp1 = Employee(101, "Sravanthi", 50000)
emp2 = Employee(102, "Rahul", 60000)

emp1.display()
print("----------------")
emp2.display()
