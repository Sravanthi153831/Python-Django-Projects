from flask import Flask, jsonify, request
import sqlite3

app = Flask(__name__)
DB_NAME = "logistics.db"

# 1. Security Logic for E-commerce Standards
def check_auth(username, password):
    return username == 'seoul_hub' and password == 'korea2026'

# 2. Database Initialization for Orders
def init_db():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS orders (
            order_id INTEGER PRIMARY KEY AUTOINCREMENT,
            product_name TEXT NOT NULL,
            delivery_status TEXT DEFAULT 'Processing',
            current_location TEXT NOT NULL
        )
    ''')
    conn.commit()
    conn.close()

# 3. GET Method - Fetch all active orders (Secured)
@app.route('/api/orders', methods=['GET'])
def get_orders():
    auth = request.authorization
    if not auth or not check_auth(auth.username, auth.password):
        return jsonify({"status": "error", "message": "Access Denied!"}), 401

    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('SELECT * FROM orders')
    rows = cursor.fetchall()
    conn.close()
    
    orders = [{"order_id": r[0], "product_name": r[1], "delivery_status": r[2], "current_location": r[3]} for r in rows]
    return jsonify(orders), 200

# 4. POST Method - Create a new product order shipment (Secured)
@app.route('/api/orders', methods=['POST'])
def create_order():
    auth = request.authorization
    if not auth or not check_auth(auth.username, auth.password):
        return jsonify({"status": "error", "message": "Access Denied!"}), 401
        
    data = request.get_json()
    if not data or 'product_name' not in data or 'current_location' not in data:
        return jsonify({"status": "error", "message": "Missing required fields!"}), 400
        
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('INSERT INTO orders (product_name, current_location) VALUES (?, ?)', 
                   (data['product_name'], data['current_location']))
    conn.commit()
    conn.close()
    
    return jsonify({"status": "success", "message": "Global Order Shipment Created Successfully!"}), 201

if __name__ == '__main__':
    init_db()
    app.run(host='0.0.0.0', port=5000, debug=True)

